{
  "$defs": {
    "Account": {
      "additionalProperties": false,
      "properties": {
        "account_type": {
          "$ref": "#/$defs/AccountType"
        },
        "cost_basis_cents": {
          "format": "int64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "opening_balance_cents": {
          "format": "int64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "owner": {
          "minLength": 1,
          "type": "string"
        },
        "tax_deferred_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaxDeferredKind"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "owner",
        "account_type",
        "opening_balance_cents"
      ],
      "type": "object"
    },
    "AccountType": {
      "enum": [
        "cash",
        "taxable",
        "tax_deferred",
        "roth"
      ],
      "type": "string"
    },
    "AgeIncome": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "$ref": "#/$defs/Amount"
        },
        "start_age": {
          "format": "uint16",
          "maximum": 130,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "amount",
        "start_age"
      ],
      "type": "object"
    },
    "Amount": {
      "additionalProperties": false,
      "properties": {
        "cents": {
          "format": "int64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "dollar_basis": {
          "$ref": "#/$defs/DollarBasis"
        }
      },
      "required": [
        "cents",
        "dollar_basis"
      ],
      "type": "object"
    },
    "Assumption": {
      "additionalProperties": false,
      "properties": {
        "effective_year": {
          "format": "uint16",
          "maximum": 9999,
          "minimum": 1,
          "type": "integer"
        },
        "identifier": {
          "minLength": 1,
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "user_overrode_default": {
          "type": "boolean"
        },
        "value": {
          "description": "Exact decimal string, never a floating-point number.",
          "pattern": "^-?[0-9]+(\\.[0-9]{1,18})?$",
          "type": "string"
        }
      },
      "required": [
        "identifier",
        "value",
        "unit",
        "source",
        "effective_year",
        "user_overrode_default"
      ],
      "type": "object"
    },
    "Bounds": {
      "properties": {
        "better": {
          "$ref": "#/$defs/PlanSummary"
        },
        "ordered": {
          "type": "boolean"
        },
        "ranked": {
          "items": {
            "$ref": "#/$defs/RankedRange"
          },
          "type": "array"
        },
        "worse": {
          "$ref": "#/$defs/PlanSummary"
        }
      },
      "required": [
        "worse",
        "better",
        "ordered",
        "ranked"
      ],
      "type": "object"
    },
    "BoundsV2": {
      "anyOf": [
        {
          "$ref": "#/$defs/Bounds"
        },
        {
          "$ref": "#/$defs/SolvedBounds"
        }
      ]
    },
    "Date": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "type": "string"
    },
    "DollarBasis": {
      "enum": [
        "nominal",
        "today"
      ],
      "type": "string"
    },
    "Fixture": {
      "additionalProperties": false,
      "properties": {
        "assumptions": {
          "items": {
            "$ref": "#/$defs/Assumption"
          },
          "type": "array"
        },
        "household": {
          "$ref": "#/$defs/Household"
        },
        "pass_limit": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "household",
        "assumptions"
      ],
      "type": "object"
    },
    "Household": {
      "additionalProperties": false,
      "properties": {
        "accounts": {
          "items": {
            "$ref": "#/$defs/Account"
          },
          "type": "array"
        },
        "income": {
          "$ref": "#/$defs/Income"
        },
        "persons": {
          "items": {
            "$ref": "#/$defs/Person"
          },
          "maxItems": 1,
          "minItems": 1,
          "type": "array"
        },
        "spending": {
          "$ref": "#/$defs/Spending"
        },
        "valuation_date": {
          "$ref": "#/$defs/Date"
        },
        "withdrawal_order": {
          "anyOf": [
            {
              "$ref": "#/$defs/WithdrawalOrder"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "valuation_date",
        "persons",
        "accounts",
        "income",
        "spending"
      ],
      "type": "object"
    },
    "Income": {
      "additionalProperties": false,
      "properties": {
        "pension": {
          "$ref": "#/$defs/AgeIncome"
        },
        "social_security": {
          "$ref": "#/$defs/AgeIncome"
        },
        "wages": {
          "items": {
            "$ref": "#/$defs/Wages"
          },
          "type": "array"
        }
      },
      "required": [
        "wages",
        "social_security",
        "pension"
      ],
      "type": "object"
    },
    "LeftOut": {
      "properties": {
        "answer": {
          "type": "string"
        },
        "direction": {
          "type": "string"
        },
        "omission": {
          "type": "string"
        }
      },
      "required": [
        "answer",
        "direction",
        "omission"
      ],
      "type": "object"
    },
    "Person": {
      "additionalProperties": false,
      "properties": {
        "birth_date": {
          "$ref": "#/$defs/Date"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "plan_end_age": {
          "format": "uint16",
          "maximum": 130,
          "minimum": 1,
          "type": "integer"
        },
        "retirement_date": {
          "$ref": "#/$defs/Date"
        }
      },
      "required": [
        "id",
        "birth_date",
        "retirement_date",
        "plan_end_age"
      ],
      "type": "object"
    },
    "PlanSummary": {
      "properties": {
        "first_shortfall_age": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "headroom": {
          "format": "int64",
          "type": "integer"
        },
        "lasts_to_plan_end": {
          "type": "boolean"
        },
        "omissions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "run_status": {
          "type": "string"
        },
        "sustainable_spending": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "run_status",
        "omissions",
        "lasts_to_plan_end",
        "headroom",
        "sustainable_spending"
      ],
      "type": "object"
    },
    "RankedRange": {
      "properties": {
        "answer": {
          "type": "string"
        },
        "headroom_at_high": {
          "format": "int64",
          "type": "integer"
        },
        "headroom_at_low": {
          "format": "int64",
          "type": "integer"
        },
        "spread": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "worse_end": {
          "type": "string"
        }
      },
      "required": [
        "answer",
        "headroom_at_low",
        "headroom_at_high",
        "spread",
        "worse_end"
      ],
      "type": "object"
    },
    "Solved": {
      "properties": {
        "answer": {
          "type": "string"
        },
        "flag": {
          "type": [
            "string",
            "null"
          ]
        },
        "unit": {
          "type": "string"
        },
        "value": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "answer",
        "unit"
      ],
      "type": "object"
    },
    "SolvedBounds": {
      "properties": {
        "better": {
          "$ref": "#/$defs/SolvedSummary"
        },
        "ordered": {
          "type": "boolean"
        },
        "ranked": {
          "items": {
            "$ref": "#/$defs/SolvedRange"
          },
          "type": "array"
        },
        "worse": {
          "$ref": "#/$defs/SolvedSummary"
        }
      },
      "required": [
        "worse",
        "better",
        "ordered",
        "ranked"
      ],
      "type": "object"
    },
    "SolvedRange": {
      "properties": {
        "answer": {
          "type": "string"
        },
        "spread": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "value_at_high": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "value_at_low": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "worse_end": {
          "type": "string"
        }
      },
      "required": [
        "answer",
        "worse_end"
      ],
      "type": "object"
    },
    "SolvedSummary": {
      "properties": {
        "first_shortfall_age": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "headroom": {
          "format": "int64",
          "type": "integer"
        },
        "lasts_to_plan_end": {
          "type": "boolean"
        },
        "omissions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "run_status": {
          "type": "string"
        },
        "solved": {
          "$ref": "#/$defs/SolvedValue"
        },
        "sustainable_spending": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "run_status",
        "omissions",
        "lasts_to_plan_end",
        "headroom",
        "sustainable_spending",
        "solved"
      ],
      "type": "object"
    },
    "SolvedValue": {
      "properties": {
        "flag": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Spending": {
      "additionalProperties": false,
      "properties": {
        "after_retirement": {
          "$ref": "#/$defs/Amount"
        },
        "before_retirement": {
          "$ref": "#/$defs/Amount"
        }
      },
      "required": [
        "before_retirement",
        "after_retirement"
      ],
      "type": "object"
    },
    "StartingValue": {
      "properties": {
        "answer": {
          "type": "string"
        },
        "direction": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": true
      },
      "required": [
        "answer",
        "value"
      ],
      "type": "object"
    },
    "TaxDeferredKind": {
      "enum": [
        "employer_plan",
        "traditional_ira"
      ],
      "type": "string"
    },
    "Wages": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "$ref": "#/$defs/Amount"
        },
        "end_date": {
          "$ref": "#/$defs/Date"
        },
        "start_date": {
          "$ref": "#/$defs/Date"
        }
      },
      "required": [
        "amount",
        "start_date",
        "end_date"
      ],
      "type": "object"
    },
    "WhatIf": {
      "additionalProperties": false,
      "properties": {
        "savings_total_cents": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "WithdrawalOrder": {
      "enum": [
        "taxable_first",
        "tax_deferred_first",
        "roth_before_tax_deferred",
        "proportional_taxable_tax_deferred"
      ],
      "type": "string"
    }
  },
  "$id": "urn:nextphase:horizon:answers-plan:v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "bounds": {
      "anyOf": [
        {
          "$ref": "#/$defs/BoundsV2"
        },
        {
          "type": "null"
        }
      ]
    },
    "central": {
      "anyOf": [
        {
          "$ref": "#/$defs/PlanSummary"
        },
        {
          "type": "null"
        }
      ]
    },
    "code": {
      "type": [
        "string",
        "null"
      ]
    },
    "household_input": {
      "anyOf": [
        {
          "$ref": "#/$defs/Fixture"
        },
        {
          "type": "null"
        }
      ]
    },
    "left_out": {
      "items": {
        "$ref": "#/$defs/LeftOut"
      },
      "type": "array"
    },
    "needed": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "not_sure": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "solved": {
      "anyOf": [
        {
          "$ref": "#/$defs/Solved"
        },
        {
          "type": "null"
        }
      ]
    },
    "starting_values": {
      "items": {
        "$ref": "#/$defs/StartingValue"
      },
      "type": "array"
    },
    "status": {
      "type": "string"
    },
    "what_if": {
      "anyOf": [
        {
          "$ref": "#/$defs/WhatIf"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "status",
    "needed",
    "left_out",
    "starting_values",
    "not_sure"
  ],
  "title": "AnswersPlanV2",
  "type": "object"
}
