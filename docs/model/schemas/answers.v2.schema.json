{
  "$defs": {
    "AccountKind": {
      "enum": [
        "cash",
        "taxable",
        "employer_plan",
        "traditional_ira",
        "roth"
      ],
      "type": "string"
    },
    "AnswerAccount": {
      "additionalProperties": false,
      "properties": {
        "balance": {
          "$ref": "#/$defs/Balance"
        },
        "cost_basis": {
          "anyOf": [
            {
              "$ref": "#/$defs/CostBasis"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "$ref": "#/$defs/AccountKind"
        }
      },
      "required": [
        "kind",
        "balance"
      ],
      "type": "object"
    },
    "AnswersFormat": {
      "enum": [
        "horizon-answers"
      ],
      "type": "string"
    },
    "AssumptionAnswers": {
      "additionalProperties": false,
      "properties": {
        "cash_return": {
          "type": [
            "string",
            "null"
          ]
        },
        "inflation": {
          "type": [
            "string",
            "null"
          ]
        },
        "investment_return": {
          "type": [
            "string",
            "null"
          ]
        },
        "tax_indexing": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Balance": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "cents": {
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "cents"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "range": {
              "$ref": "#/$defs/CentRange"
            }
          },
          "required": [
            "range"
          ],
          "type": "object"
        }
      ]
    },
    "BirthAnswerV2": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "date": {
              "$ref": "#/$defs/Date"
            }
          },
          "required": [
            "date"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "age": {
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "age"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "later": {
              "$ref": "#/$defs/Yes"
            }
          },
          "required": [
            "later"
          ],
          "type": "object"
        }
      ]
    },
    "CentRange": {
      "additionalProperties": false,
      "properties": {
        "high_cents": {
          "format": "int64",
          "type": "integer"
        },
        "low_cents": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "low_cents",
        "high_cents"
      ],
      "type": "object"
    },
    "CostBasis": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "cents": {
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "cents"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "later": {
              "$ref": "#/$defs/Yes"
            }
          },
          "required": [
            "later"
          ],
          "type": "object"
        }
      ]
    },
    "Date": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "type": "string"
    },
    "Expectation": {
      "enum": [
        "yes",
        "no",
        "not_sure"
      ],
      "type": "string"
    },
    "MoneyAnswer": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "cents": {
              "format": "int64",
              "type": "integer"
            },
            "per": {
              "$ref": "#/$defs/Period",
              "default": "year"
            }
          },
          "required": [
            "cents"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "per": {
              "$ref": "#/$defs/Period",
              "default": "year"
            },
            "range": {
              "$ref": "#/$defs/CentRange"
            }
          },
          "required": [
            "range"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "later": {
              "$ref": "#/$defs/Yes"
            }
          },
          "required": [
            "later"
          ],
          "type": "object"
        }
      ]
    },
    "PayEnds": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "at_retirement": {
              "$ref": "#/$defs/Yes"
            }
          },
          "required": [
            "at_retirement"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "date": {
              "$ref": "#/$defs/Date"
            }
          },
          "required": [
            "date"
          ],
          "type": "object"
        }
      ]
    },
    "Pension": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "expects": {
              "const": "no",
              "type": "string"
            }
          },
          "required": [
            "expects"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "amount": {
              "$ref": "#/$defs/MoneyAnswer"
            },
            "expects": {
              "const": "yes",
              "type": "string"
            },
            "rises_with_prices": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Expectation"
                },
                {
                  "type": "null"
                }
              ]
            },
            "start_age": {
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "expects",
            "amount"
          ],
          "type": "object"
        }
      ]
    },
    "Period": {
      "enum": [
        "year",
        "month"
      ],
      "type": "string"
    },
    "Planning": {
      "enum": [
        "alone",
        "partner"
      ],
      "type": "string"
    },
    "Retirement": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "age": {
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "age"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "date": {
              "$ref": "#/$defs/Date"
            }
          },
          "required": [
            "date"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "later": {
              "$ref": "#/$defs/Yes"
            }
          },
          "required": [
            "later"
          ],
          "type": "object"
        }
      ]
    },
    "RetirementSpending": {
      "anyOf": [
        {
          "$ref": "#/$defs/MoneyAnswer"
        },
        {
          "additionalProperties": false,
          "properties": {
            "same_as_now": {
              "$ref": "#/$defs/Yes"
            }
          },
          "required": [
            "same_as_now"
          ],
          "type": "object"
        }
      ]
    },
    "Savings": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "none": {
              "$ref": "#/$defs/Yes"
            }
          },
          "required": [
            "none"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "later": {
              "$ref": "#/$defs/Yes"
            }
          },
          "required": [
            "later"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "accounts": {
              "items": {
                "$ref": "#/$defs/AnswerAccount"
              },
              "type": "array"
            }
          },
          "required": [
            "accounts"
          ],
          "type": "object"
        }
      ]
    },
    "SocialSecurity": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "anyOf": [
            {
              "$ref": "#/$defs/MoneyAnswer"
            },
            {
              "type": "null"
            }
          ]
        },
        "expects": {
          "$ref": "#/$defs/Expectation"
        },
        "start_age": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "expects"
      ],
      "type": "object"
    },
    "WhatIf": {
      "additionalProperties": false,
      "properties": {
        "savings_total_cents": {
          "format": "int64",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "Yes": {
      "const": true,
      "type": "boolean"
    }
  },
  "$id": "urn:nextphase:horizon:answers:v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assumptions": {
      "$ref": "#/$defs/AssumptionAnswers",
      "default": {
        "cash_return": null,
        "inflation": null,
        "investment_return": null,
        "tax_indexing": null
      }
    },
    "birth_date": {
      "$ref": "#/$defs/BirthAnswerV2"
    },
    "format": {
      "$ref": "#/$defs/AnswersFormat"
    },
    "not_sure": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "pay": {
      "anyOf": [
        {
          "$ref": "#/$defs/MoneyAnswer"
        },
        {
          "type": "null"
        }
      ]
    },
    "pay_ends": {
      "$ref": "#/$defs/PayEnds",
      "default": {
        "at_retirement": true
      }
    },
    "pension": {
      "$ref": "#/$defs/Pension"
    },
    "plan_end_age": {
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "planning": {
      "$ref": "#/$defs/Planning"
    },
    "retired": {
      "type": "boolean"
    },
    "retirement": {
      "anyOf": [
        {
          "$ref": "#/$defs/Retirement"
        },
        {
          "type": "null"
        }
      ]
    },
    "savings": {
      "$ref": "#/$defs/Savings"
    },
    "social_security": {
      "$ref": "#/$defs/SocialSecurity"
    },
    "spending_in_retirement": {
      "$ref": "#/$defs/RetirementSpending"
    },
    "spending_now": {
      "anyOf": [
        {
          "$ref": "#/$defs/MoneyAnswer"
        },
        {
          "type": "null"
        }
      ]
    },
    "valuation_date": {
      "$ref": "#/$defs/Date"
    },
    "version": {
      "format": "uint8",
      "maximum": 2,
      "minimum": 2,
      "type": "integer"
    },
    "what_if": {
      "anyOf": [
        {
          "$ref": "#/$defs/WhatIf"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "format",
    "version",
    "valuation_date",
    "planning",
    "birth_date",
    "retired",
    "social_security",
    "pension",
    "savings",
    "spending_in_retirement"
  ],
  "title": "AnswersV2",
  "type": "object"
}
